# wallet-kms environment variables (KCONE-integrated mode)

# Vault connection — required
VAULT_URL=http://localhost:8200
VAULT_TOKEN=

# SOR (System-of-Records) JSON-RPC proxy — required
# Kernel forwards requests here; wallet-kms routes all chain calls through SOR.
SOR_BASE_URL=http://localhost:8888

# Gasless relay URL — optional; only required for /signAndSubmitGaslessTxn
# PROXY_URL=https://gasless.example.com
